{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gharzetak-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Local development uses Wrangler's simulated D1 + R2 (persisted under .wrangler/state).
  // Nothing here touches the real Cloudflare account until you deploy or pass --remote.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gharzetak-db",
      // PLACEHOLDER: replace with the real id printed by `wrangler d1 create gharzetak-db`
      // (remote creation is approval-gated). Local dev/test does not need a real id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],

  // Private bucket. No public domain, no r2.dev access: the Worker is the only reader/writer.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gharzetak-media" }],

  "vars": {
    "ENVIRONMENT": "development",
    // Public URL of this API (used for auth email links).
    "AUTH_BASE_URL": "http://localhost:8787",
    // Origins allowed by CORS and Better Auth CSRF/origin checks. Capacitor WebViews use
    // http(s)://localhost (Android) and capacitor://localhost (iOS); the custom scheme is the deep link.
    "APP_ORIGINS": "http://localhost:4200,http://localhost,https://localhost,capacitor://localhost,com.gharzetak.app://",
    "REQUIRE_EMAIL_VERIFICATION": "false",
    // Khayoota AI, LOCAL ONLY: the offline fake provider (deterministic demo replies, never a real model).
    // There is no AI binding here on purpose: ordinary dev and tests can never call Workers AI.
    "AI_ENABLED": "true",
    "AI_PROVIDER": "fake",
    "AI_VISION_ENABLED": "true",
    "AI_EXTRACT_ENABLED": "true"
  },

  // ---------------------------------------------------------------------------------------------
  // STAGING: Worker gharzetak-api-staging + D1 gharzetak-db-staging exist and are live for the test APK.
  // Every deploy and remote migration is approval-gated (docs/khayoota-ai/staging-rollout-readiness.md).
  // Deploy with `--env staging` ONLY. Wrangler does not inherit bindings/vars into an env, so they are repeated.
  // The Worker refuses to serve while any REPLACE_* placeholder below is still present.
  // ---------------------------------------------------------------------------------------------
  "env": {
    "staging": {
      "name": "gharzetak-api-staging",
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gharzetak-db-staging",
          // Created with `wrangler d1 create gharzetak-db-staging` (region WEUR). The id is an identifier, not a secret.
          "database_id": "23160160-69cf-4d4c-ad1e-38889b4eb351",
          "migrations_dir": "drizzle"
        }
      ],
      // The SAME private bucket as other environments, isolated by the key prefix below.
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gharzetak-media" }],
      "vars": {
        "ENVIRONMENT": "staging",
        "MEDIA_PREFIX": "staging/",
        // Public URL of the staging Worker (account workers.dev subdomain: gharzetak).
        "AUTH_BASE_URL": "https://gharzetak-api-staging.gharzetak.workers.dev",
        // Only the installed app's own origins: Android Capacitor WebView (https://localhost), iOS (capacitor://localhost) and the deep-link scheme. No dev-server origin.
        "APP_ORIGINS": "https://localhost,capacitor://localhost,com.gharzetak.app://",
        // Turn on once a mail provider exists (otherwise nobody could ever sign in).
        "REQUIRE_EMAIL_VERIFICATION": "false",
        // Khayoota AI (docs/khayoota-ai/staging-rollout-readiness.md). Master switch OFF: Stage A deploys with it off;
        // Stage B flips ONLY AI_ENABLED after a separate approval. Photos and pattern extraction stay OFF (flags AND
        // zero quotas) until their quality gates pass. There is no third-party fallback provider in the code at all.
        "AI_ENABLED": "false",
        "AI_PROVIDER": "workers-ai",
        "AI_MODEL_CHAT": "@cf/google/gemma-4-26b-a4b-it",
        "AI_MODEL_VISION": "@cf/google/gemma-4-26b-a4b-it",
        "AI_MODEL_EXTRACT": "@cf/google/gemma-4-26b-a4b-it",
        "AI_VISION_ENABLED": "false",
        "AI_EXTRACT_ENABLED": "false",
        "AI_USER_DAILY_CHAT": "20",
        "AI_USER_DAILY_IMAGE": "0",
        "AI_USER_DAILY_EXTRACT": "0",
        // The free 10,000 Neurons/day are shared by the WHOLE Cloudflare account (every Worker, the dashboard
        // playground, scripts). 3,000 (~75-95 text chats) leaves 7,000 for anything else on the account.
        "AI_DAILY_NEURON_BUDGET": "3000",
        "AI_DAILY_REQUEST_CAP": "100",
        "AI_CONSENT_VERSION": "1",
        // Controlled internal test: comma-separated staging user ids. EMPTY = nobody (fail-closed); "*" = every account.
        "AI_ALLOWED_USER_IDS": ""
      },
      // Workers AI binding (inactive while AI_ENABLED is "false"). Only takes effect on an approved deploy.
      "ai": { "binding": "AI" }
    }
  }
}
