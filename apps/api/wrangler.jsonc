{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gharzetak-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Local development uses Wrangler's simulated D1 + R2 (persisted under .wrangler/state).
  // Nothing here touches the real Cloudflare account until you deploy or pass --remote.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gharzetak-db",
      // PLACEHOLDER: replace with the real id printed by `wrangler d1 create gharzetak-db`
      // (remote creation is approval-gated). Local dev/test does not need a real id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],

  // Private bucket. No public domain, no r2.dev access: the Worker is the only reader/writer.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gharzetak-media" }],

  "vars": {
    "ENVIRONMENT": "development",
    // Public URL of this API (used for auth email links).
    "AUTH_BASE_URL": "http://localhost:8787",
    // Origins allowed by CORS and Better Auth CSRF/origin checks. Capacitor WebViews use
    // http(s)://localhost (Android) and capacitor://localhost (iOS); the custom scheme is the deep link.
    "APP_ORIGINS": "http://localhost:4200,http://localhost,https://localhost,capacitor://localhost,com.gharzetak.app://",
    "REQUIRE_EMAIL_VERIFICATION": "false"
  },

  // ---------------------------------------------------------------------------------------------
  // STAGING (for the `development` branch). NOTHING here exists remotely yet: creating the D1 database,
  // setting the secret and deploying are approval-gated (docs/cloudflare-migration/staging-readiness.md).
  // Deploy with `--env staging` ONLY. Wrangler does not inherit bindings/vars into an env, so they are repeated.
  // The Worker refuses to serve while any REPLACE_* placeholder below is still present.
  // ---------------------------------------------------------------------------------------------
  "env": {
    "staging": {
      "name": "gharzetak-api-staging",
      "observability": { "enabled": true },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gharzetak-db-staging",
          // Created with `wrangler d1 create gharzetak-db-staging` (region WEUR). The id is an identifier, not a secret.
          "database_id": "23160160-69cf-4d4c-ad1e-38889b4eb351",
          "migrations_dir": "drizzle"
        }
      ],
      // The SAME private bucket as other environments, isolated by the key prefix below.
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "gharzetak-media" }],
      "vars": {
        "ENVIRONMENT": "staging",
        "MEDIA_PREFIX": "staging/",
        // Public URL of the staging Worker (account workers.dev subdomain: gharzetak).
        "AUTH_BASE_URL": "https://gharzetak-api-staging.gharzetak.workers.dev",
        // Only the installed app's own origins: Android Capacitor WebView (https://localhost), iOS (capacitor://localhost) and the deep-link scheme. No dev-server origin.
        "APP_ORIGINS": "https://localhost,capacitor://localhost,com.gharzetak.app://",
        // Turn on once a mail provider exists (otherwise nobody could ever sign in).
        "REQUIRE_EMAIL_VERIFICATION": "false"
      }
    }
  }
}
