# Copy to .env (never commit .env). Only PUBLIC values belong here.
# scripts/set-env.mjs turns this file into src/environments/env.generated.ts before serve/build/test.

# Base URL of the Gharzetak Cloudflare Worker API.
#   local dev:        http://localhost:8787   (run `npm run api:dev`)
#   Android emulator: http://10.0.2.2:8787
#   production:       https://<your-worker-domain>   (must be https)
# Empty = guest-only mode (no account, no sync).
GZ_API_URL=

# Where email links (confirm sign-up, reset password) return. Empty = current origin.
# Native builds use the deep link, e.g. com.gharzetak.app://auth/reset
GZ_AUTH_REDIRECT_URL=

# Google sign-in. PUBLIC ids only: the Google client SECRET lives only in the Worker (apps/api/.dev.vars or `wrangler secret put`).
#   Web application client id = audience of the ID token returned by the native Google picker.
GZ_GOOGLE_WEB_CLIENT_ID=
#   iOS client id (optional: Google sign-in stays Android-only while empty).
GZ_GOOGLE_IOS_CLIENT_ID=

# Set to 1 ONLY when the Worker has a real mail provider (password-reset / verification emails are delivered). Empty hides "Forgot password".
GZ_PASSWORD_RESET=

# API path of the AI assistant, e.g. /v1/assistant. Empty = clearly-labelled demo mode.
GZ_AI_ENDPOINT=

# Product tours (Getting Started card, first-visit pills, Settings replays). On by default; set to 0 to switch every tour surface off in a release build.
GZ_TOURS=1
# Public legal pages (privacy policy, terms, account deletion), e.g. https://<legal-site-domain>. Empty = Settings shows the legal rows as
# "not published yet". With GZ_RELEASE=1 the build REFUSES to run without it (Google Play requires these links).
GZ_LEGAL_BASE_URL=
