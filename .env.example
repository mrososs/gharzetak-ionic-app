# Copy to .env (never commit .env). Only PUBLIC values belong here.
# scripts/set-env.mjs turns this file into src/environments/env.generated.ts before serve/build/test.

# Supabase project URL — the DEDICATED Gharzetak project (or local: http://127.0.0.1:54321)
GZ_SUPABASE_URL=
# Publishable (anon) key. NEVER the service_role / sb_secret_ key — the script refuses it.
GZ_SUPABASE_PUBLISHABLE_KEY=

# Where email links (confirm sign-up, reset password) return. Empty = current origin.
# Android deep link example: com.gharzetak.app://auth/callback
GZ_AUTH_REDIRECT_URL=

# OAuth providers that are configured in Supabase Auth, comma separated (e.g. google,apple). Empty = hidden/disabled.
GZ_OAUTH_PROVIDERS=

# Supabase Edge Function name for the AI assistant. Empty = clearly-labelled demo mode.
GZ_AI_FUNCTION=
