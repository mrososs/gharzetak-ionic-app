{
  "name": "gharzetak",
  "version": "0.0.0",
  "scripts": {
    "env": "node scripts/set-env.mjs",
    "ng": "ng",
    "prestart": "npm run env",
    "start": "ng serve --host 0.0.0.0",
    "prebuild": "npm run env",
    "build": "ng build",
    "pretest": "npm run env",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "typecheck": "npm run env && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "cap:sync": "npm run build && npx cap sync",
    "android:build": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "android:open": "npx cap open android",
    "api:install": "npm --prefix apps/api install",
    "api:dev": "npm --prefix apps/api run dev",
    "api:test": "npm --prefix apps/api test",
    "api:typecheck": "npm --prefix apps/api run typecheck",
    "api:db:migrate:local": "npm --prefix apps/api run db:migrate:local",
    "api:db:seed:local": "npm --prefix apps/api run db:seed:local",
    "api:smoke": "node apps/api/scripts/smoke-local.mjs",
    "e2e:sync": "npm run env && vitest run -c vitest.e2e.config.ts"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/playpen-sans": "^5.3.0",
    "@fontsource-variable/playpen-sans-arabic": "^5.3.0",
    "@ionic/angular": "^9.0.11",
    "idb": "^8.0.4",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/postcss": "^4.3.5",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.33",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
